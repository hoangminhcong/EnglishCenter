# Cấu hình môi trường cho ứng dụng Staff Web (Admin, Sale, Kế toán, Giáo vụ, Giảng viên)
# Port phát triển mặc định: 5174 (tách biệt độc lập với Client Web ở port 5173)
# Tuyệt đối KHÔNG đặt JWT Secret hay Database Password vào các biến VITE_*

VITE_API_BASE_URL=
VITE_STAFF_API_BASE_URL=
VITE_CLIENT_APP_URL=http://localhost:5173
VITE_STAFF_APP_URL=http://localhost:5174
VITE_STAFF_USE_MOCK_API=true
VITE_STAFF_DATA_SOURCE=mock
