# Cấu hình môi trường cho ứng dụng Client Web (Public Website + Student Portal)
# Port phát triển mặc định: 5173 (độc lập với Staff Web ở port 5174)
# Khi Backend Node.js sẵn sàng, điền VITE_API_BASE_URL (VD: http://localhost:4000/api/v1) và đặt VITE_USE_MOCK_API=false:

VITE_API_BASE_URL=
VITE_CLIENT_APP_URL=http://localhost:5173
VITE_STAFF_APP_URL=http://localhost:5174
VITE_USE_MOCK_API=true
VITE_DATA_SOURCE=mock
